@page "/trip-selection"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using DataAccess
@using BustickWeb.Data
@inject IDbContextFactory<BustickWebContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Trip Selection</PageTitle>

<div class="container py-3">
    <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-4">
        <div>
            <h4 class="mb-0">@HeaderFrom <span class="text-muted mx-2">→</span> @HeaderTo</h4>
            <div class="text-muted">@HeaderDate</div>
        </div>
        <button class="btn btn-outline-dark" @onclick="GoHome">Modify Search</button>
    </div>

    <div class="row">
        <div class="col-md-3">
            <div class="card p-3 mb-3">
                <h6 class="mb-3">Filters</h6>

                <div class="mb-3">
                    <label class="form-label fw-bold">Time</label>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="filterMorning" />
                        <label class="form-check-label">Morning (06:00-12:00)</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="filterAfternoon" />
                        <label class="form-check-label">Afternoon (12:00-18:00)</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="filterEvening" />
                        <label class="form-check-label">Evening (18:00-24:00)</label>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Price Range</label>
                    <div class="d-flex gap-2">
                        <input type="number" class="form-control" placeholder="Min" @bind="minPrice" />
                        <input type="number" class="form-control" placeholder="Max" @bind="maxPrice" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Operator</label>
                    @if (operators == null)
                    {
                        <div class="text-muted">Loading...</div>
                    }
                    else
                    {
                        @foreach (var op in operators)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       checked="@selectedOperatorIds.Contains(op.Id)"
                                       @onchange="(e) => ToggleOperator(op.Id, (bool)e.Value!)" />
                                <label class="form-check-label">@op.CompanyName</label>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-md-9">
            @if (errorMessage != null)
            {
                <div class="alert alert-danger">@errorMessage</div>
            }
            else if (allTrips == null)
            {
                <div class="alert alert-info">Loading trips...</div>
            }
            else if (!FilteredTrips.Any())
            {
                <div class="d-flex justify-content-center align-items-center"
                     style="min-height: 60vh;">

                    <div class="text-center p-5 bg-white shadow rounded"
                         style="max-width: 600px; width: 100%;">

                        <div style="font-size: 5rem;">😕</div>

                        <h3 class="mt-3">No trips found</h3>

                        <p class="text-muted fs-6">
                            We couldn’t find any trips matching your search criteria.
                        </p>

                        <button class="btn btn-dark mt-3 px-4"
                                @onclick="GoBackToHome">
                            Modify Search
                        </button>
                    </div>
                </div>
            }
            else
            {
                @foreach (var t in FilteredTrips)
                {
                    <div class="card p-3 mb-3 shadow-sm">
                        <div class="d-flex justify-content-between align-items-center">

                            <div class="d-flex gap-4 align-items-center" style="min-width: 300px;">
                                <div class="text-center">
                                    <div class="fw-bold fs-5">@t.DepartureTime.ToString("HH:mm")</div>
                                    <div class="text-muted small">@t.OriginCity</div>
                                </div>
                                <div class="text-muted d-flex flex-column align-items-center">
                                    <small>@FormatDuration(t.DepartureTime, t.ArrivalTime)</small>
                                    <i class="bi bi-arrow-right">→</i>
                                </div>
                                <div class="text-center">
                                    <div class="fw-bold fs-5">@t.ArrivalTime.ToString("HH:mm")</div>
                                    <div class="text-muted small">@t.DestinationCity</div>
                                </div>
                            </div>

                            <div class="text-center">
                                <div class="fw-bold">@t.OperatorName</div>
                                <div class="badge bg-light text-dark border mt-1">
                                    @t.SeatsLeft seats left
                                </div>
                                <div class="text-muted" style="font-size: 10px;">@t.DepartureTime.ToString("dd MMM yyyy")</div>
                            </div>

                            <div class="text-end" style="min-width: 120px;">
                                <div class="fw-bold fs-4 text-primary">@t.Price.ToString("C0")</div>
                                <button class="btn btn-dark mt-1 w-100" @onclick="() => SelectTrip(t.TripId)">
                                    Select
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? From { get; set; }
    [SupplyParameterFromQuery] public string? To { get; set; }
    [SupplyParameterFromQuery] public string? Date { get; set; }

    private List<TripCardVM>? allTrips;
    private List<DataAccess.Operator>? operators;
    private HashSet<int> selectedOperatorIds = new();

    // Filters
    private bool filterMorning, filterAfternoon, filterEvening;
    private decimal minPrice = 0, maxPrice = 5000;

    private string? errorMessage;
    private DateTime travelDate = DateTime.Today;

    private string HeaderFrom => From ?? "All";
    private string HeaderTo => To ?? "All";
    private string HeaderDate => string.IsNullOrEmpty(Date) ? "All Dates" : travelDate.ToString("dd MMMM yyyy");

    protected override async Task OnParametersSetAsync()
    {
        if (DateTime.TryParse(Date, out var d)) travelDate = d.Date;
        await LoadDataAsync();
    }

    void GoBackToHome()
    {
        Nav.NavigateTo("/");
    }

    private async Task LoadDataAsync()
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();

            if (operators == null)
            {
                operators = await db.Set<DataAccess.Operator>().ToListAsync();
            }

            // Create Query
            var query = from t in db.Trip
                        join r in db.Set<Route>() on t.RouteId equals r.Id
                        join o in db.Set<DataAccess.Operator>() on t.OperatorId equals o.Id
                        join b in db.Set<Bus>() on t.BusId equals b.Id
                        join tk in db.Set<Ticket>() on t.Id equals tk.TripId into tickets
                        select new
                        {
                            Trip = t,
                            Route = r,
                            Operator = o,
                            Bus = b,
                            SoldInfo = tickets.Count()
                        };

            if (!string.IsNullOrEmpty(Date))
            {

                query = query.Where(x => x.Trip.DepartureTime >= travelDate && x.Trip.DepartureTime < travelDate.AddDays(1));
            }
            else
            {

            }

            // City Filters
            if (!string.IsNullOrEmpty(From))
                query = query.Where(x => x.Route.OriginCity == From);

            if (!string.IsNullOrEmpty(To))
                query = query.Where(x => x.Route.DestinationCity == To);

            var result = await query.ToListAsync();

            allTrips = result.Select(x => new TripCardVM
            {
                TripId = x.Trip.Id,
                DepartureTime = x.Trip.DepartureTime,
                ArrivalTime = x.Trip.ArrivalTime,
                Price = x.Trip.Price,
                OriginCity = x.Route.OriginCity,
                DestinationCity = x.Route.DestinationCity,
                OperatorId = x.Operator.Id,
                OperatorName = x.Operator.CompanyName,
                SeatCapacity = x.Bus.SeatCapacity,
                SeatsLeft = Math.Max(0, x.Bus.SeatCapacity - x.SoldInfo)
            }).ToList();

        }
        catch (Exception ex)
        {
            errorMessage = "Error loading data: " + ex.Message;
            Console.WriteLine(ex.ToString());
        }
    }

    private IEnumerable<TripCardVM> FilteredTrips
    {
        get
        {
            if (allTrips == null) return Enumerable.Empty<TripCardVM>();
            var q = allTrips.AsEnumerable();

            //Others
            q = q.Where(x => x.Price >= minPrice && x.Price <= maxPrice);

            if (selectedOperatorIds.Any())
                q = q.Where(x => selectedOperatorIds.Contains(x.OperatorId));

            if (filterMorning || filterAfternoon || filterEvening)
            {
                q = q.Where(x =>
                {
                    var h = x.DepartureTime.Hour;
                    return (filterMorning && h >= 6 && h < 12) ||
                           (filterAfternoon && h >= 12 && h < 18) ||
                           (filterEvening && h >= 18);
                });
            }

            return q.OrderBy(x => x.DepartureTime);
        }
    }

    private void ToggleOperator(int opId, bool isChecked)
    {
        if (isChecked) selectedOperatorIds.Add(opId);
        else selectedOperatorIds.Remove(opId);
    }

    private void SelectTrip(int tripId) => Nav.NavigateTo($"/seat-selection/{tripId}");
    private void GoHome() => Nav.NavigateTo("/");

    private string FormatDuration(DateTime dep, DateTime arr)
    {
        var diff = arr - dep;
        return $"{(int)diff.TotalHours}h {diff.Minutes}m";
    }

    public class TripCardVM
    {
        public int TripId { get; set; }
        public DateTime DepartureTime { get; set; }
        public DateTime ArrivalTime { get; set; }
        public decimal Price { get; set; }
        public string OriginCity { get; set; } = "";
        public string DestinationCity { get; set; } = "";
        public int OperatorId { get; set; }
        public string OperatorName { get; set; } = "";
        public int SeatCapacity { get; set; }
        public int SeatsLeft { get; set; }
    }
}