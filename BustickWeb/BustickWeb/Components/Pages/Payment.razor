@page "/payment"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using DataAccess
@using BustickWeb.Data
@using System.Globalization
@inject IDbContextFactory<BustickWebContext> DbFactory
@inject NavigationManager Nav

<button class="btn btn-success" @onclick="CompletePayment">
    Complete Payment
</button>

@code {
    void CompletePayment()
    {
        // payment logic (SaveChanges vs.)

        Nav.NavigateTo("/", true);
    }
}


<div class="container py-5">
    @if (_loading)
    {
        <div class="text-center">Loading payment page...</div>
    }
    else if (_vm == null)
    {
        <div class="alert alert-danger">Invalid transaction. Please select a trip again.</div>
    }
    else
    {
        <div class="row g-5">
            <div class="col-md-7">
                <h4 class="mb-3">Payment Details</h4>
                <div class="card p-4">
                    <div class="mb-3">
                        <label class="form-label">Card Number</label>
                        <input type="text" class="form-control" placeholder="0000 0000 0000 0000">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Cardholder Name</label>
                        <input type="text" class="form-control" placeholder="Full Name">
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Expiration Date</label>
                            <input type="text" class="form-control" placeholder="MM/YY">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">CVV</label>
                            <input type="text" class="form-control" placeholder="***">
                        </div>
                    </div>
                    <hr class="my-4">
                    <button class="btn btn-dark w-100 btn-lg" @onclick="CompletePayment">
                        Pay @_vm.Price.ToString("C2", CultureInfo.CreateSpecificCulture("en-US")) & Complete
                    </button>
                </div>
            </div>

            <div class="col-md-5">
                <h4 class="mb-3">Summary</h4>
                <ul class="list-group mb-3 shadow-sm">
                    <li class="list-group-item d-flex justify-content-between lh-sm">
                        <div>
                            <h6 class="my-0">Route</h6>
                            <small class="text-muted">@_vm.From → @_vm.To</small>
                        </div>
                    </li>
                    <li class="list-group-item d-flex justify-content-between lh-sm">
                        <div>
                            <h6 class="my-0">Operator</h6>
                            <small class="text-muted">@_vm.OperatorName</small>
                        </div>
                    </li>
                    <li class="list-group-item d-flex justify-content-between lh-sm">
                        <div>
                            <h6 class="my-0">Seat No</h6>
                            <small class="text-muted">No: @_vm.SeatNo</small>
                        </div>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Total</span>
                        <strong>@_vm.Price.ToString("C2", CultureInfo.CreateSpecificCulture("en-US"))</strong>
                    </li>
                </ul>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "tripId")] public int TripId { get; set; }
    [SupplyParameterFromQuery(Name = "seatNo")] public int SeatNo { get; set; }

    private bool _loading = true;
    private PaymentVm? _vm;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var t = await db.Trip
                .Include(x => x.Route)
                .Include(x => x.Operator)
                .FirstOrDefaultAsync(x => x.Id == TripId);

            if (t != null)
            {
                _vm = new PaymentVm
                {
                    From = t.Route.OriginCity,
                    To = t.Route.DestinationCity,
                    OperatorName = t.Operator.CompanyName,
                    Price = t.Price,
                    SeatNo = SeatNo
                };
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    class PaymentVm
    {
        public string From { get; set; } = "";
        public string To { get; set; } = "";
        public string OperatorName { get; set; } = "";
        public decimal Price { get; set; }
        public int SeatNo { get; set; }
    }
}