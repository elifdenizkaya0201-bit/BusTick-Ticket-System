@page "/trips"

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using DataAccess
@using BustickWeb.Data
@implements IAsyncDisposable
@inject IDbContextFactory<BustickWeb.Data.BustickWebContext> DbFactory

<PageTitle>Index</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">Manage Trips</h3>

    <NavLink class="btn btn-dark" href="trips/create">
        Add Trip
    </NavLink>
</div>

<div class="card p-3">

<QuickGrid TGridItem="Trip"
           Class="table align-middle mb-0"
           Items="trips">

        <TemplateColumn TGridItem="Trip" Title="Route" Context="trip">
    @trip.Route.OriginCity → @trip.Route.DestinationCity
</TemplateColumn>

    <PropertyColumn Property="trip => trip.DepartureTime" />
    <PropertyColumn Property="trip => trip.Bus.PlateNo" Title="Bus" />
            <TemplateColumn Title="Price" Context="trip">
         ₺@trip.Price.ToString("N2")
    </TemplateColumn>

    <TemplateColumn Title="Status" Context="trip">
    @if (trip.Status == "Completed")
    {
        <span class="badge bg-success">Completed</span>
    }
    else if (trip.Status == "Cancelled")
    {
        <span class="badge bg-danger">Cancelled</span>
    }
    else
    {
        <span class="badge bg-secondary">@trip.Status</span>
    }
</TemplateColumn>

   <TemplateColumn Title="Actions" Context="trip">
    <NavLink class="btn btn-sm btn-outline-secondary me-2"
             href="@($"/trips/details/{trip.Id}")">
        Details
    </NavLink>

    <NavLink class="btn btn-sm btn-outline-primary me-2"
             href="@($"/trips/edit/{trip.Id}")">
        Edit
    </NavLink>

    <NavLink class="btn btn-sm btn-outline-danger"
             href="@($"/trips/delete/{trip.Id}")">
        Delete
    </NavLink>
</TemplateColumn>

</QuickGrid>
</div>

@code {
    @code {
    private BustickWebContext context = default!;
    private IQueryable<Trip> trips = default!;


    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();

        trips = context.Trip
    .Include(t => t.Route)
    .Include(t => t.Operator)
    .Include(t => t.Bus);

    }

    public async ValueTask DisposeAsync() =>
        await context.DisposeAsync();
}

}
