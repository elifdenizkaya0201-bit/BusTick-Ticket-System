@page "/trips/delete/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using DataAccess
@inject IDbContextFactory<BustickWeb.Data.BustickWebContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete Trip</PageTitle>

<div class="container py-4">
    <h1>Delete Trip</h1>
    <p class="text-danger">Are you sure you want to delete this trip?</p>

    @if (trip is null)
    {
        <div class="alert alert-info">Loading trip details...</div>
    }
    else
    {
        <div class="card p-4 mb-4">
            <dl class="row mb-0">
                <dt class="col-sm-3">Route</dt>
                <dd class="col-sm-9">
                    @(trip.Route != null ? $"{trip.Route.OriginCity} → {trip.Route.DestinationCity}" : trip.RouteId.ToString())
                </dd>

                <dt class="col-sm-3">Operator</dt>
                <dd class="col-sm-9">
                    @(trip.Operator != null ? trip.Operator.CompanyName : trip.OperatorId.ToString())
                </dd>

                <dt class="col-sm-3">Date</dt>
                <dd class="col-sm-9">@trip.DepartureTime.ToString("dd MMM yyyy HH:mm")</dd>

                <dt class="col-sm-3">Price</dt>
                <dd class="col-sm-9">@trip.Price.ToString("C2")</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@trip.Status</dd>
            </dl>
        </div>

        <EditForm Model="trip" OnValidSubmit="DeleteTrip" FormName="deleteTripForm">
            <button type="submit" class="btn btn-danger">Yes, Delete</button>
            <a href="/trips" class="btn btn-secondary ms-2">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Trip? trip;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();

        // Load trip
        trip = await context.Trip
            .Include(t => t.Route)
            .Include(t => t.Operator)
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (trip is null)
        {
            NavigationManager.NavigateTo("/not-found");
        }
    }

    private async Task DeleteTrip()
    {
        using var context = await DbFactory.CreateDbContextAsync();

        var tripToDelete = await context.Trip
            .Include(t => t.SeatReservations)
            .Include(t => t.Tickets)
            .FirstOrDefaultAsync(t => t.Id == Id);

        if (tripToDelete != null)
        {
            context.SeatReservations.RemoveRange(tripToDelete.SeatReservations);
            context.Tickets.RemoveRange(tripToDelete.Tickets);

            context.Trip.Remove(tripToDelete);

            await context.SaveChangesAsync();
        }

        NavigationManager.NavigateTo("/trips");
    }

    }


}